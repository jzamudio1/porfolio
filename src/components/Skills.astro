---
import { cvContent, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = cvContent[lang].skills
---

<div class="grid gap-5 md:grid-cols-2">
  {copy.groups.map((group) => (
    <article class="rounded-2xl border border-gray-200/80 bg-white/70 p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white">{group.title}</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {group.items.map((item) => (
          <li class="rounded-full bg-gray-100 px-3 py-1.5 text-sm text-gray-700 dark:bg-gray-800 dark:text-gray-300">{item}</li>
        ))}
      </ul>
    </article>
  ))}
</div>
