---
import { cvContent, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = cvContent[lang].professionalProjects
---

<div class="grid gap-5 md:grid-cols-2">
  {copy.projects.map((project) => (
    <article class="rounded-2xl border border-gray-200/80 bg-white/70 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/50">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">{copy.eyebrow}</p>
      <h3 class="mt-2 text-xl font-bold text-gray-900 dark:text-white">{project.title}</h3>
      <p class="mt-3 leading-relaxed text-gray-600 dark:text-gray-400">{project.description}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <li class="rounded-full border border-gray-200 px-2.5 py-1 text-xs text-gray-700 dark:border-gray-700 dark:text-gray-300">{tag}</li>
        ))}
      </ul>
    </article>
  ))}
</div>
