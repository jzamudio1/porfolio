---
import Layout from "@/layouts/Layout.astro"
import Hero from "@/components/Hero.astro"
import Experience from "@/components/Experience.astro"
import ProfessionalProjects from "@/components/ProfessionalProjects.astro"
import Projects from "@/components/Projects.astro"
import Skills from "@/components/Skills.astro"
import Education from "@/components/Education.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import TitleSection from "@/components/TitleSection.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import { cvContent, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = cvContent[lang]
---

<Layout title={copy.meta.title} description={copy.meta.description} lang={lang}>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero lang={lang} />
    </SectionContainer>

    <div class="space-y-24">
      <SectionContainer id="experiencia">
        <TitleSection>
          <Briefcase class="size-8" />
          {copy.sections.experience}
        </TitleSection>
        <Experience lang={lang} />
      </SectionContainer>

      <SectionContainer id="proyectos-profesionales">
        <TitleSection>
          <Briefcase class="size-7" />
          {copy.sections.professionalProjects}
        </TitleSection>
        <ProfessionalProjects lang={lang} />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <TitleSection>
          <CodeIcon class="size-7" />
          {copy.sections.personalProjects}
        </TitleSection>
        <Projects lang={lang} />
      </SectionContainer>

      <SectionContainer id="habilidades">
        <TitleSection>
          <ProfileCheck class="size-8" />
          {copy.sections.skills}
        </TitleSection>
        <Skills lang={lang} />
      </SectionContainer>

      <SectionContainer id="formacion">
        <TitleSection>
          <ProfileCheck class="size-8" />
          {copy.sections.education}
        </TitleSection>
        <Education lang={lang} />
      </SectionContainer>
    </div>
  </main>
</Layout>
