---
import { cvContent, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = cvContent[lang].experience
---

<article class="rounded-2xl border border-gray-200/80 bg-white/70 p-6 md:p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
  <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
    <div>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{copy.role}</h3>
      <p class="mt-1 text-lg font-semibold text-blue-600 dark:text-blue-400">{copy.company}</p>
    </div>
    <time class="text-sm font-medium text-gray-500 dark:text-gray-400">{copy.period}</time>
  </div>

  <ul class="mt-6 grid gap-3 text-gray-700 dark:text-gray-300">
    {copy.responsibilities.map((item) => (
      <li class="flex gap-3 leading-relaxed">
        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-yellow-400"></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</article>
