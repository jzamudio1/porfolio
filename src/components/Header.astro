---
import ThemeToggle from "./ThemeToggle.astro"

const baseUrl = import.meta.env.BASE_URL
const navItems = [
  { title: "Experiencia", label: "experiencia", url: `${baseUrl}#experiencia` },
  { title: "Proyectos", label: "proyectos", url: `${baseUrl}#proyectos-profesionales` },
  { title: "Habilidades", label: "habilidades", url: `${baseUrl}#habilidades` },
  { title: "Formación", label: "formacion", url: `${baseUrl}#formacion` },
  { title: "Contacto", label: "contacto", url: "mailto:jesuszamudionoguera@gmail.com" },
]
---

<header class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2">
  <nav class="flex max-w-[calc(100vw-1rem)] overflow-x-auto px-3 text-sm font-medium rounded-full text-gray-600 dark:text-gray-200 justify-start sm:justify-center items-center">
    {navItems.map((link) => (
      <a class="relative block whitespace-nowrap px-2 py-2 transition hover:text-blue-500 dark:hover:text-blue-500" aria-label={link.label} href={link.url}>
        {link.title}
      </a>
    ))}
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            const label = item.getAttribute("aria-label")
            const matchesProject = label === "proyectos" && entry.target.id.startsWith("proyectos")
            item.classList.toggle("text-blue-500", label === entry.target.id || matchesProject)
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => observer.observe(section))

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") observer.disconnect()
      else sections.forEach((section) => observer.observe(section))
    }
  })
</script>

<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
    background-color: rgb(255 255 255 / 0.5);
  }

  :global(.dark) nav {
    background-color: rgb(31 41 55 / 0.9);
  }

  @keyframes nav-shadow {
    from {
      box-shadow: none;
      backdrop-filter: blur(0);
    }
    to {
      box-shadow: 0 10px 30px -12px rgb(15 23 42 / 0.35);
      backdrop-filter: blur(12px);
    }
  }
</style>
