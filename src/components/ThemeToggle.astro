---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import SystemIcon from "./icons/System.astro"
---

<div class="relative ml-1 mr-1 shrink-0">
  <button
    id="theme-toggle-btn"
    type="button"
    class="relative grid size-9 place-items-center rounded-full border border-transparent text-gray-600 transition hover:bg-gray-100 hover:text-gray-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/60 dark:text-gray-200 dark:hover:bg-gray-700 dark:hover:text-white"
    aria-label="Cambiar tema"
    title="Cambiar tema"
  >
    <SunIcon id="light" class="theme-toggle-icon absolute size-5 transition duration-200" />
    <MoonIcon id="dark" class="theme-toggle-icon absolute size-5 transition duration-200" />
    <SystemIcon id="system" class="theme-toggle-icon absolute size-5 transition duration-200" />
  </button>
</div>

<script is:inline>
  const themeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)")
  const themeOrder = ["system", "light", "dark"]
  const themeLabels = {
    system: "Sistema",
    light: "Claro",
    dark: "Oscuro",
  }

  const getThemePreference = () => localStorage.getItem("theme") ?? "system"

  const updateThemeIcon = (themePreference) => {
    document.querySelectorAll(".theme-toggle-icon").forEach((element) => {
      const isActive = element.id === themePreference
      element.style.opacity = isActive ? "1" : "0"
      element.style.transform = isActive ? "scale(1) rotate(0deg)" : "scale(0.65) rotate(-20deg)"
    })
  }

  const updateThemeButtonLabel = (themePreference) => {
    const button = document.getElementById("theme-toggle-btn")
    if (!button) return

    const currentIndex = themeOrder.indexOf(themePreference)
    const nextTheme = themeOrder[(currentIndex + 1) % themeOrder.length]
    const currentLabel = themeLabels[themePreference]
    const nextLabel = themeLabels[nextTheme]
    const label = `Tema: ${currentLabel}. Cambiar a ${nextLabel}`

    button.setAttribute("aria-label", label)
    button.setAttribute("title", label)
  }

  const applyTheme = (themePreference) => {
    const isDark =
      themePreference === "dark" ||
      (themePreference === "system" && themeMediaQuery.matches)

    document.documentElement.classList.toggle("dark", isDark)
    updateThemeIcon(themePreference)
    updateThemeButtonLabel(themePreference)
  }

  const cycleTheme = () => {
    const currentTheme = getThemePreference()
    const currentIndex = themeOrder.indexOf(currentTheme)
    const nextTheme = themeOrder[(currentIndex + 1) % themeOrder.length]

    localStorage.setItem("theme", nextTheme)
    applyTheme(nextTheme)
  }

  const initThemeToggle = () => {
    const button = document.getElementById("theme-toggle-btn")
    if (!button) return

    button.onclick = cycleTheme
    applyTheme(getThemePreference())
  }

  initThemeToggle()
  document.addEventListener("astro:page-load", initThemeToggle)

  themeMediaQuery.addEventListener("change", () => {
    if (getThemePreference() === "system") applyTheme("system")
  })
</script>
