---
import GitHub from "./icons/GitHub.astro"
import LinkButton from "./LinkButton.astro"
import { cvContent, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = cvContent[lang].personalProjects
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    copy.projects.map(({ title, eyebrow, description, tags, github }) => (
      <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200/80 bg-white/70 p-6 shadow-sm backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl dark:border-gray-800 dark:bg-gray-900/60 dark:hover:border-blue-500/50">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-500/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
          {eyebrow}
        </p>

        <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">
          {title}
        </h3>

        <p class="mt-3 flex-1 leading-relaxed text-gray-600 dark:text-gray-400">
          {description}
        </p>

        <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${copy.technologiesLabel} ${title}`}>
          {tags.map((tag) => (
            <li class="rounded-full border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-medium text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
              {tag}
            </li>
          ))}
        </ul>

        {github && (
          <footer class="mt-6">
            <LinkButton href={github}>
              <GitHub class="size-5" />
              {copy.githubLabel}
            </LinkButton>
          </footer>
        )}
      </article>
    ))
  }
</div>
